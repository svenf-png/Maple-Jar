# Kopie als .env.local anlegen und Platzhalter ersetzen. .env.local wird nicht committet.

# Supabase: Project Settings → API Keys
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable Key (sb_publishable_…). NIEMALS den Secret Key hier eintragen.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Base-Pfad für GitHub Pages (im Deploy-Workflow automatisch /<repo>/). Lokal: /
VITE_BASE=/
